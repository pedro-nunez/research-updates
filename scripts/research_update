#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 0 ]]; then
    if [[ $# -eq 1 && "$1" == --help ]]; then
        printf '%s\n' \
            'Usage: research_update' \
            'Create today’s entry if needed and open the monthly file in Vim.'
        exit 0
    fi
    printf 'research_update: unexpected argument; use --help for usage.\n' >&2
    exit 1
fi

# Locate the repository, including when this command is symlinked.
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_dir="$(cd -- "$(dirname "$script_path")" && pwd -P)"
    link_target="$(readlink "$script_path")"
    if [[ "$link_target" == /* ]]; then
        script_path="$link_target"
    else
        script_path="${script_dir}/${link_target}"
    fi
done

repo_dir="$(cd -- "$(dirname "$script_path")/.." && pwd -P)"
months_dir="${repo_dir}/months"
main_file="${repo_dir}/main.tex"

if [[ ! -f "$main_file" ]]; then
    printf 'Error: main.tex file does not exist: %s\n' "$main_file" >&2
    exit 1
fi

if ! command -v vim >/dev/null 2>&1; then
    printf 'Error: vim was not found.\n' >&2
    exit 1
fi

date_fields="$(LC_ALL=C date '+%Y-%m|%B %Y|%Y-%m-%d|%Y-%m-%d (%A)')"
IFS='|' read -r current_month month_title current_date date_title <<< "$date_fields"

printf 'Current month is %s, i.e., %s.\n' "$current_month" "$month_title"
printf 'Current date: %s.\n' "$date_title"

month_file="${months_dir}/${current_month}.tex"
include_line="\\include{months/${current_month}}"
date_heading="\\dayentry{${current_date}}"
date_label="\\phantomsection\\label{day:${current_date}}"

tmp=""
cleanup() {
    if [[ -n "$tmp" ]]; then
        rm -f "$tmp"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$months_dir"

# Create the monthly file the first time it is used.
if [[ ! -f "$month_file" ]]; then
    printf '%s\n\n' "\\chapter{${month_title}}" > "$month_file"
fi

# Include the monthly file in main.tex if necessary.
if ! grep -Fxq "$include_line" "$main_file"; then
    tmp="$(mktemp "${main_file}.tmp.XXXXXX")"
    cp -p "$main_file" "$tmp"

    INCLUDE_LINE="$include_line" awk '
        BEGIN {
            new = ENVIRON["INCLUDE_LINE"]
        }

        {
            lines[NR] = $0

            if ($0 ~ /\\include\{months\//) {
                last_include = NR
            }

            if ($0 ~ /Monthly files:/ && !monthly_marker) {
                monthly_marker = NR
            }
        }

        END {
            target = last_include ? last_include : monthly_marker

            for (i = 1; i <= NR; i++) {
                print lines[i]

                if (target && i == target) {
                    print new
                    inserted = 1
                }
            }

            if (!inserted) {
                print "Error: could not find a place to insert the monthly include." > "/dev/stderr"
                exit 1
            }
        }
    ' "$main_file" > "$tmp"

    mv "$tmp" "$main_file"
    tmp=""
fi

# Add today's heading if necessary.
if ! grep -Fxq "$date_label" "$month_file"; then
    {
        printf '\n'
        printf '%s\n' "$date_heading"
        printf '%s\n' "$date_label"
        printf '\n'
    } >> "$month_file"
fi

(
    cd "$months_dir"
    vim '+normal! Go' '+startinsert' "${current_month}.tex"
)
